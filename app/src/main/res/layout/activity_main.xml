<?xml version="1.0" encoding="utf-8"?>
<!--
    activity_main.xml — MINIMAL
    Contains only a single full-screen ComposeView.
    ALL UI (home screen, toolbar, buttons, AR controls, HUD) is in Compose.
    No native views overlay the Compose content.
-->
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:id="@+id/rootLayout">

    <androidx.compose.ui.platform.ComposeView
        android:id="@+id/arComposeView"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

</FrameLayout>
